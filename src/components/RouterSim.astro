  const SYS = 2000, TURN = 300, OUT = 200;
  function simulate(apps: number[], reqs: [number, number][], policy: string, n: number, cap: number) {
    const caches = Array.from({ length: n }, () => new Map<string, number>()), size = Array(n).fill(0), load = Array(n).fill(0), hitsBy = Array(n).fill(0);
    let hit = 0, all = 0;
    reqs.forEach(([s, t], k) => {
      const bl: [string, number][] = [[`a${apps[s]}`, SYS], ...Array.from({ length: t }, (_, i) => [`s${s}_${i}`, TURN] as [string, number])];
      const hits = (i: number) => { let h = 0; for (const [key, c] of bl) { if (caches[i].has(key)) h += c; else break; } return h; };
      const avg = load.reduce((a, b) => a + b, 0) / n;
      let i = 0;
      if (policy === 'rr') i = k % n;
      else if (policy === 'll') { for (let j = 1; j < n; j++) if (load[j] < load[i]) i = j; }
      else if (policy === 'sess') i = s % n;
      else if (policy === 'app') i = apps[s] % n;
      else { let ok = [...Array(n).keys()].filter((j) => load[j] <= 1.2 * avg + 1); if (!ok.length) ok = [...Array(n).keys()]; i = ok[0]; let best = [hits(i), -load[i]]; for (const j of ok.slice(1)) { const v = [hits(j), -load[j]]; if (v[0] > best[0] || (v[0] === best[0] && v[1] > best[1])) { i = j; best = v; } } }
      const h = hits(i), total = bl.reduce((a, [, c]) => a + c, 0);
      hit += h; all += total; hitsBy[i] += h; load[i] += total - h + OUT * 20;
      for (const [key, c] of [...bl, [`s${s}_${t}`, TURN] as [string, number]]) { if (caches[i].has(key)) { size[i] -= caches[i].get(key)!; caches[i].delete(key); } caches[i].set(key, c); size[i] += c; }
      while (size[i] > cap) { const first = caches[i].keys().next().value!; size[i] -= caches[i].get(first)!; caches[i].delete(first); }
    });
    return { hr: hit / all, load, imb: Math.max(...load) / (load.reduce((a, b) => a + b, 0) / n) };
  }
  function init(fig: HTMLElement) {
    const Wd = JSON.parse(fig.dataset.w!); let policy = 'ca';
    const nIn = fig.querySelector<HTMLInputElement>('[data-n]')!, cIn = fig.querySelector<HTMLInputElement>('[data-c]')!;
    const NAMES: Record<string, string> = { rr: '轮询', ll: '最空闲', sess: '按会话固定', app: '按应用固定', ca: '缓存感知（限负载）' };
    function draw() {
      const n = Number(nIn.value), cap = Number(cIn.value); fig.querySelector('[data-nv]')!.textContent = String(n); fig.querySelector('[data-cv]')!.textContent = cap.toLocaleString();
      const r = simulate(Wd.apps, Wd.reqs, policy, n, cap), mx = Math.max(...r.load);
      fig.querySelector<HTMLElement>('[data-rows]')!.innerHTML = r.load.map((v, i) => `<div class="ai-kq-row" style="grid-template-columns:56px 1fr 90px"><b>实例 ${i}</b><span class="ai-kq-bar"><i style="width:${(v / mx) * 100}%"></i></span><span>${(v / 1e6).toFixed(2)}M</span></div>`).join('');
      const all = Object.keys(NAMES).map((p) => { const x = simulate(Wd.apps, Wd.reqs, p, n, cap); return `${NAMES[p]} ${(x.hr * 100).toFixed(1)}% / ${x.imb.toFixed(2)}×`; }).join('；');
      fig.querySelector<HTMLElement>('[data-eq]')!.innerHTML = `${NAMES[policy]}：前缀缓存命中率 <b>${(r.hr * 100).toFixed(1)}%</b>，最忙实例的工作量是平均的 <b>${r.imb.toFixed(2)} 倍</b>（柱子是各实例的总工作量）。`
        + `<br><span class="ai-faint">五种策略（命中率 / 最忙是平均的几倍）：${all}</span>`;
    }
    fig.addEventListener('input', draw);
    fig.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-group] [data-v]'); if (!b) return; policy = b.dataset.v!; fig.querySelectorAll('[data-group] [data-v]').forEach((x) => x.setAttribute('aria-pressed', x === b ? 'true' : 'false')); draw(); });
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-routersim]').forEach(init);
</script>
