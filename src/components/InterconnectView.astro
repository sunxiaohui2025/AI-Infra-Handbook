---
// 两台 8 卡服务器的互联拓扑（以 DGX H100 一类的设计为原型的示意，数字与第 56 讲的代码相同）。
// 机内：8 张 GPU 都接在 NVSwitch 上（每卡单向约 450 GB/s）；每张 GPU 经 PCIe 交换芯片接一张 400 Gb/s 的网卡和 CPU。
// 机间：网卡接到网络交换机（InfiniBand 或 RoCE，每卡约 50 GB/s）。读者可以：选一条路径，调消息大小，看路径上的瓶颈、延迟和传输时间。
interface Props { title?: string; caption?: string }
const { title = '数据从一张卡到另一张卡走哪条路', caption } = Astro.props;
---
<figure class="ai-gt ai-ic" data-interconnect>
  <div class="ai-ms-title">{title}</div>
  <div class="ai-tl-ctl">
    <div class="ai-gt-pre ai-pc-sets" data-group="p"><button data-v="nv" aria-pressed="true">同机两卡（NVLink）</button><button data-v="pcie" aria-pressed="false">同机两卡（只有 PCIe）</button><button data-v="net" aria-pressed="false">跨机两卡（网络）</button><button data-v="cpu" aria-pressed="false">GPU ↔ CPU 内存</button></div>
    <label class="ai-tl-lr"><span>消息 <b data-mv></b></span><input type="range" min="0" max="6" step="1" value="3" data-m /></label>
  </div>
  <div data-svg></div>
  <div class="ai-cg-eq" data-eq></div>
  {caption && <figcaption class="ai-fig-cap">{caption}</figcaption>}
</figure>

<script>
  const MS = [8e3, 64e3, 1e6, 16e6, 256e6, 1e9, 16e9];
  const PATHS: Record<string, { segs: [string, number][]; a: number; hl: string[]; note: string }> = {
    nv: { segs: [['NVLink → NVSwitch → NVLink', 450e9]], a: 3e-6, hl: ['g0', 'nvs0', 'g1'], note: '同一台机器里，8 张卡都接在 NVSwitch 上，任意两张卡之间都是满带宽。张量并行的 All-Reduce 就走这里（第 93 讲）。' },
    pcie: { segs: [['GPU → PCIe 交换芯片', 64e9], ['PCIe 交换芯片 → GPU', 64e9]], a: 5e-6, hl: ['g0', 'pcie0', 'g1'], note: '没有 NVLink 的机器（比如消费级显卡、一些推理卡），卡与卡之间只能走 PCIe，带宽只有 NVLink 的七分之一。' },
    net: { segs: [['GPU → PCIe → 网卡', 64e9], ['网卡 → 交换机 → 网卡（400 Gb/s）', 50e9], ['网卡 → PCIe → GPU', 64e9]], a: 6e-6, hl: ['g0', 'pcie0', 'nic0', 'sw', 'nic1', 'pcie1', 'g8'], note: '跨机时，数据经 PCIe 到网卡，经网络交换机到对方的网卡，再经 PCIe 进对方的 GPU。用 GPUDirect RDMA 时网卡直接读写 GPU 显存，不经过 CPU 内存中转。瓶颈是网卡的 50 GB/s。' },
    cpu: { segs: [['GPU → PCIe → CPU 内存', 64e9]], a: 5e-6, hl: ['g0', 'pcie0', 'cpu0'], note: 'KV Cache 卸载到 CPU 内存（第 101 讲）、加载模型权重，都走这条路。' },
  };
  function init(fig: HTMLElement) {
    let p = 'nv';
    const mIn = fig.querySelector<HTMLInputElement>('[data-m]')!;
    const fmtB = (b: number) => (b >= 1e9 ? `${b / 1e9} GB` : b >= 1e6 ? `${b / 1e6} MB` : `${b / 1e3} KB`);
    const fmtT = (t: number) => (t >= 1e-3 ? `${(t * 1e3).toFixed(2)} ms` : `${(t * 1e6).toFixed(1)} μs`);
    function draw() {
      const m = MS[Number(mIn.value)], P = PATHS[p], hl = new Set(P.hl); fig.querySelector('[data-mv]')!.textContent = fmtB(m);
      const box = (id: string, x: number, y: number, w: number, h: number, t: string, cls: string) => `<g class="ai-ic-b ${cls}${hl.has(id) ? ' is-on' : ''}"><rect x="${x}" y="${y}" width="${w}" height="${h}" rx="4"/><text x="${x + w / 2}" y="${y + h / 2 + 4}" text-anchor="middle">${t}</text></g>`;
      let s = '<svg class="ai-tl-svg" viewBox="0 0 600 230">';
      [0, 1].forEach((n) => {
        const ox = n * 330;
        s += `<rect class="ai-ic-node" x="${ox + 5}" y="5" width="260" height="215" rx="8"/><text class="ai-al-gl" x="${ox + 12}" y="20">服务器 ${n}</text>`;
        for (let i = 0; i < 8; i++) s += box(`g${n * 8 + i}`, ox + 14 + i * 31, 28, 28, 26, `G${i}`, 'gpu');
        s += box(`nvs${n}`, ox + 14, 64, 246, 22, 'NVSwitch（每卡 450 GB/s）', 'nvs');
        s += box(`pcie${n}`, ox + 14, 100, 246, 22, 'PCIe 交换芯片（每卡 64 GB/s）', 'pcie');
        s += box(`nic${n}`, ox + 14, 136, 120, 24, '网卡 ×8（400 Gb/s）', 'nic') + box(`cpu${n}`, ox + 140, 136, 120, 24, 'CPU + 内存', 'cpu');
      });
      s += box('sw', 220, 186, 160, 26, '网络交换机（IB / RoCE）', 'nic');
      s += `<line class="ai-ic-w${hl.has('sw') ? ' is-on' : ''}" x1="75" y1="160" x2="220" y2="199"/><line class="ai-ic-w${hl.has('sw') ? ' is-on' : ''}" x1="405" y1="160" x2="380" y2="199"/>`;
      fig.querySelector<HTMLElement>('[data-svg]')!.innerHTML = s + '</svg>';
      const bott = Math.min(...P.segs.map((x) => x[1])), t = P.a + m / bott;
      fig.querySelector<HTMLElement>('[data-eq]')!.innerHTML = `路径：${P.segs.map(([n, b]) => `${n}（${b / 1e9} GB/s）`).join(' → ')}。瓶颈 ${bott / 1e9} GB/s。`
        + `<br>传 ${fmtB(m)}：α ${(P.a * 1e6).toFixed(0)} μs + ${fmtB(m)} ÷ ${bott / 1e9} GB/s = <b>${fmtT(t)}</b>（延迟占 ${Math.round(P.a / t * 100)}%）。`
        + `<br><span class="ai-faint">${P.note}</span>`;
    }
    mIn.addEventListener('input', draw);
    fig.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-group] [data-v]'); if (!b) return; p = b.dataset.v!; fig.querySelectorAll('[data-group] [data-v]').forEach((x) => x.setAttribute('aria-pressed', x === b ? 'true' : 'false')); draw(); });
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-interconnect]').forEach(init);
</script>
