---
// 词嵌入演示。
//   mode="lookup"：TinyLM 的嵌入表 E（6×4）。点词加入句子，每个 token 的编号去 E 里查对应的一行；
//                  点句子里的某个 token，看“独热向量 × E = E 的那一行”。
//   mode="map"   ：小语料上训练的 ToyLM 的嵌入（14 个词 × 8 维），投影到二维画出来（tinylm.json examples["22"]）。
//                  可切换“训练前 / 训练后”；点一个词，连线到 8 维空间里余弦相似度最高的 3 个词。
import tiny from '../data/tinylm.json';
interface Props { mode?: 'lookup' | 'map'; title?: string; caption?: string }
const { mode = 'lookup', caption } = Astro.props;
const { title = mode === 'lookup' ? '查表：编号 → 嵌入表的一行' : '训练出来的嵌入：作用相近的词靠在一起' } = Astro.props;
const cfg = mode === 'lookup'
  ? { vocab: tiny.config.vocab, E: tiny.weights.embedding }
  : { vocab: tiny.examples['22'].vocab, E: tiny.examples['22'].E, E0: tiny.examples['22'].E0, pca: tiny.examples['22'].pca, pca0: tiny.examples['22'].pca0 };
---
<figure class="ai-gt ai-emb" data-embview data-mode={mode} data-cfg={JSON.stringify(cfg)}>
  <div class="ai-ms-title">{title}</div>
  {mode === 'lookup' ? (
    <>
      <div class="ai-gt-pre ai-pc-sets" data-add></div>
      <div class="ai-emb-seq" data-seq></div>
      <div class="ai-emb-grid">
        <div><div class="ai-mlp-pt">嵌入表 E（6 × 4，每个词一行）</div><table class="ai-emb-tbl" data-etbl></table></div>
        <div><div class="ai-mlp-pt">查出来的结果 X（句子长度 × 4）</div><table class="ai-emb-tbl" data-xtbl></table></div>
      </div>
      <div class="ai-cg-eq" data-eq></div>
    </>
  ) : (
    <>
      <div class="ai-gt-pre ai-pc-sets"><button data-v="after" aria-pressed="true">训练后</button><button data-v="before" aria-pressed="false">训练前（随机初始化）</button></div>
      <div class="ai-vp-body">
        <svg class="ai-vp-svg" viewBox="0 0 360 320" data-map role="img" aria-label={title}></svg>
        <div class="ai-vp-side"><div class="ai-vp-read" data-read></div></div>
      </div>
    </>
  )}
  {caption && <figcaption class="ai-fig-cap">{caption}</figcaption>}
</figure>

<script>
  const fmt = (v: number, d = 2) => { const k = 10 ** d; v = Math.round(v * k) / k; if (Object.is(v, -0)) v = 0; return v < 0 ? '−' + -v : String(v); };
  const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  const cos = (a: number[], b: number[]) => { let d = 0, na = 0, nb = 0; a.forEach((x, i) => { d += x * b[i]; na += x * x; nb += b[i] * b[i]; }); return d / Math.sqrt(na * nb); };

  function lookup(fig: HTMLElement, cfg: { vocab: string[]; E: number[][] }) {
    const { vocab, E } = cfg;
    let seq = [0, 1, 2, 3], sel = 0;
    const q = (s: string) => fig.querySelector<HTMLElement>(s)!;
    q('[data-add]').innerHTML = '<span class="ai-tl-k">点词加入句子：</span>' + vocab.map((w, i) => `<button data-add-id="${i}">${esc(w)}</button>`).join('') + '<button data-clear>清空</button>';
    function draw() {
      q('[data-seq]').innerHTML = seq.length ? seq.map((id, p) => `<button class="ai-emb-tok${p === sel ? ' is-sel' : ''}" data-pos="${p}"><b>${esc(vocab[id])}</b><small>编号 ${id}</small></button>`).join('') : '<span class="ai-faint">句子是空的</span>';
      const cur = seq[sel];
      const head = '<thead><tr><th></th>' + E[0].map((_, j) => `<th>${j + 1}</th>`).join('') + '</tr></thead>';
      q('[data-etbl]').innerHTML = head + '<tbody>' + E.map((r, i) => `<tr class="${i === cur ? 'is-sel' : seq.includes(i) ? 'is-used' : ''}"><th>${i} ${esc(vocab[i])}</th>${r.map((v) => `<td>${fmt(v, 1)}</td>`).join('')}</tr>`).join('') + '</tbody>';
      q('[data-xtbl]').innerHTML = head + '<tbody>' + seq.map((id, p) => `<tr class="${p === sel ? 'is-sel' : ''}"><th>${p + 1} ${esc(vocab[id])}</th>${E[id].map((v) => `<td>${fmt(v, 1)}</td>`).join('')}</tr>`).join('') + '</tbody>';
      if (cur === undefined) { q('[data-eq]').innerHTML = '点上面的词，把它加进句子。'; return; }
      const oh = vocab.map((_, i) => (i === cur ? 1 : 0));
      const col0 = E.map((r) => r[0]);
      q('[data-eq]').innerHTML = `第 ${sel + 1} 个 token“${esc(vocab[cur])}”的编号是 ${cur}，查表就是取 E 的第 ${cur} 行（从 0 数）：(${E[cur].map((v) => fmt(v, 1)).join(', ')})`
        + `<br><span class="ai-faint">等价的写法：独热向量 (${oh.join(', ')}) 乘 E。比如结果的第 1 个数 = ${oh.map((o, i) => `${o}×${fmt(col0[i], 1).replace(/^−/, '(−') + (col0[i] < 0 ? ')' : '')}`).join(' + ')} = ${fmt(E[cur][0], 1)}：只有编号那一位的 1 起作用。</span>`;
    }
    fig.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const add = t.closest<HTMLElement>('[data-add-id]'), pos = t.closest<HTMLElement>('[data-pos]');
      if (add) { if (seq.length < 8) { seq.push(Number(add.dataset.addId)); sel = seq.length - 1; } }
      else if (t.closest('[data-clear]')) { seq = []; sel = 0; }
      else if (pos) sel = Number(pos.dataset.pos);
      else return;
      draw();
    });
    draw();
  }

  function map(fig: HTMLElement, cfg: { vocab: string[]; E: number[][]; E0: number[][]; pca: number[][]; pca0: number[][] }) {
    const svg = fig.querySelector<SVGSVGElement>('[data-map]')!, read = fig.querySelector<HTMLElement>('[data-read]')!;
    let after = true, sel = cfg.vocab.indexOf('苹果');
    function draw() {
      const P = after ? cfg.pca : cfg.pca0, E = after ? cfg.E : cfg.E0;
      const xs = P.map((p) => p[0]), ys = P.map((p) => p[1]);
      const pad = 0.12, x0 = Math.min(...xs), x1 = Math.max(...xs), y0 = Math.min(...ys), y1 = Math.max(...ys);
      const span = Math.max(x1 - x0, y1 - y0) * (1 + 2 * pad);
      const cx = (x0 + x1) / 2, cy = (y0 + y1) / 2;
      const X = (x: number) => 180 + (x - cx) / span * 320, Y = (y: number) => 160 - (y - cy) / span * 300;
      const sims = cfg.vocab.map((_, j) => (j === sel ? -2 : cos(E[sel], E[j])));
      const top = sims.map((s, j) => [s, j]).sort((a, b) => b[0] - a[0]).slice(0, 3).map((x) => x[1]);
      let s = `<g class="ai-vp-grid"><line x1="20" y1="${Y(0)}" x2="340" y2="${Y(0)}"/><line x1="${X(0)}" y1="10" x2="${X(0)}" y2="310"/></g>`;
      for (const j of top) s += `<line class="ai-emb-link" x1="${X(P[sel][0])}" y1="${Y(P[sel][1])}" x2="${X(P[j][0])}" y2="${Y(P[j][1])}"/>`;
      // 标签避让：按 y 排序，离得太近的往下挪一点
      const placed: [number, number][] = [];
      cfg.vocab.forEach((w, i) => {
        const px = X(P[i][0]), py = Y(P[i][1]);
        let ly = py - 8;
        for (const [qx, qy] of placed) if (Math.abs(qx - px) < 34 && Math.abs(qy - ly) < 12) ly = qy + 13;
        placed.push([px, ly]);
        const cls = i === sel ? ' is-sel' : top.includes(i) ? ' is-near' : '';
        s += `<circle class="ai-emb-pt${cls}" cx="${px}" cy="${py}" r="${i === sel ? 5 : 3.5}" data-i="${i}"/>`;
        s += `<text class="ai-emb-lab${cls}" x="${px + 6}" y="${ly}" data-i="${i}">${esc(w)}</text>`;
      });
      svg.innerHTML = s;
      read.innerHTML = `<div class="ai-vp-row"><span>选中</span><div>“${esc(cfg.vocab[sel])}”</div></div>`
        + `<table class="ai-vp-tbl"><thead><tr><th>最相似的词（8 维余弦）</th><th>余弦</th></tr></thead><tbody>${top.map((j) => `<tr><td>${esc(cfg.vocab[j])}</td><td>${fmt(sims[j])}</td></tr>`).join('')}</tbody></table>`
        + `<div class="ai-vp-row ai-vp-hint">${after ? '训练后：在句子里起相同作用的词（比如都是句末的宾语）被拉到了一起。图是 8 维投影到 2 维的结果，远近只是大致的，右边的余弦是在 8 维里算的。' : '训练前：嵌入是随机数，位置没有规律，“最相似”的词也是碰巧的。'} 点图上的词换一个。</div>`;
    }
    svg.addEventListener('click', (e) => { const i = (e.target as SVGElement).dataset?.i; if (i !== undefined) { sel = Number(i); draw(); } });
    fig.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-v]');
      if (!b) return;
      after = b.dataset.v === 'after';
      fig.querySelectorAll('[data-v]').forEach((x) => x.setAttribute('aria-pressed', x === b ? 'true' : 'false'));
      draw();
    });
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-embview]').forEach((f) => { const c = JSON.parse(f.dataset.cfg!); if (f.dataset.mode === 'lookup') lookup(f, c); else map(f, c); });
</script>
