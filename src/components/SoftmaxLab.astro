---
// softmax 步进（数据默认取 TinyLM 读到“我”之后给 6 个词的打分，与第 6 讲的代码相同）。
// 每一步：z ÷ T → 减去最大值 → 取指数 → 除以总和。读者可以：改每个词的打分（输入框），调温度 T，看每一步的数和最后的概率柱。
interface Props { title?: string; caption?: string }
const { title = '把分数变成概率', caption } = Astro.props;
const VOCAB = ['我', '爱', '学', 'AI', '推理', '<eos>'];
const Z = [1.64, 0.83, -0.39, -0.17, -0.46, 0.37];
---
<figure class="ai-gt ai-sx" data-softmax data-v={JSON.stringify(VOCAB)} data-z={JSON.stringify(Z)}>
  <div class="ai-ms-title">{title}</div>
  <label class="ai-tl-lr"><span>温度 T = <b data-tv></b></span><input type="range" min="-1.3" max="1" step="0.05" value="0" data-t /></label>
  <div class="ai-qs-tab" data-tab></div>
  <div data-svg></div>
  <div class="ai-cg-eq" data-eq></div>
  {caption && <figcaption class="ai-fig-cap">{caption}</figcaption>}
</figure>

<script>
  function init(fig: HTMLElement) {
    const V: string[] = JSON.parse(fig.dataset.v!); const z: number[] = JSON.parse(fig.dataset.z!);
    const tIn = fig.querySelector<HTMLInputElement>('[data-t]')!;
    const tab = fig.querySelector<HTMLElement>('[data-tab]')!;
    tab.innerHTML = `<table><tr><th>词</th>${V.map((w) => `<td>${w.replace('<', '&lt;')}</td>`).join('')}</tr><tr><th>打分 z（可改）</th>${z.map((v, i) => `<td><input class="ai-sx-in" data-i="${i}" value="${v}" /></td>`).join('')}</tr><tr><th>z ÷ T − max</th>${V.map((_, i) => `<td data-r1="${i}"></td>`).join('')}</tr><tr><th>e^(…)</th>${V.map((_, i) => `<td data-r2="${i}"></td>`).join('')}</tr><tr><th>÷ 总和 = 概率</th>${V.map((_, i) => `<td data-r3="${i}"></td>`).join('')}</tr></table>`;
    function draw() {
      const T = 10 ** Number(tIn.value); fig.querySelector('[data-tv]')!.textContent = T.toFixed(2);
      tab.querySelectorAll<HTMLInputElement>('.ai-sx-in').forEach((el) => { const v = Number(el.value); if (Number.isFinite(v)) z[Number(el.dataset.i)] = v; });
      const zt = z.map((v) => v / T), mx = Math.max(...zt), sh = zt.map((v) => v - mx), e = sh.map(Math.exp), sum = e.reduce((a, b) => a + b, 0), p = e.map((v) => v / sum);
      V.forEach((_, i) => { tab.querySelector(`[data-r1="${i}"]`)!.textContent = sh[i].toFixed(2); tab.querySelector(`[data-r2="${i}"]`)!.textContent = e[i].toFixed(3); tab.querySelector(`[data-r3="${i}"]`)!.textContent = p[i].toFixed(3); });
      let s = '<svg class="ai-tl-svg" viewBox="0 0 600 140">';
      p.forEach((v, i) => { const x = 40 + i * 92, h = v * 110; s += `<rect class="ai-sx-bar" x="${x}" y="${118 - h}" width="60" height="${h}"/><text class="ai-al-gl" x="${x + 30}" y="${112 - h}" text-anchor="middle">${(v * 100).toFixed(1)}%</text><text class="ai-al-gl" x="${x + 30}" y="134" text-anchor="middle">${V[i].replace('<', '&lt;')}</text>`; });
      fig.querySelector<HTMLElement>('[data-svg]')!.innerHTML = s + '</svg>';
      const H = -p.reduce((a, v) => a + (v > 0 ? v * Math.log(v) : 0), 0);
      fig.querySelector<HTMLElement>('[data-eq]')!.innerHTML = `总和 Σe = ${sum.toFixed(3)}；最大的概率 ${(Math.max(...p) * 100).toFixed(1)}%（“${V[p.indexOf(Math.max(...p))].replace('<', '&lt;')}”）；分布的熵 ${H.toFixed(2)}（最大可能是 ln 6 = 1.79，越小越“尖”）。`
        + `<br><span class="ai-faint">${T < 0.9 ? '温度小于 1：分数之间的差距被放大，分布变尖，最高分的词占了大头。' : T > 1.1 ? '温度大于 1：差距被缩小，分布变平，低分的词也有机会。' : '温度为 1：就是原始的 softmax。'}减去最大值不改变结果，只是防止 e^z 溢出。</span>`;
    }
    fig.addEventListener('input', draw);
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-softmax]').forEach(init);
</script>
