---
// Triton 的“程序”与数据块并排（与第 88 讲的代码对应）。
// 向量模式：n 个元素、每块 BLOCK 个，网格 = ⌈n / BLOCK⌉ 个程序；选一个程序，看它的 offs、mask，以及对应的代码行。
// 矩阵乘法模式：C 是 64 × 64，每个程序负责 BM × BN 的一块，沿 K 方向每次取 A 的 BM × BK、B 的 BK × BN；拖动 k 看它取了哪两块。
interface Props { title?: string; caption?: string }
const { title = 'Triton：一个程序处理一整块', caption } = Astro.props;
---
<figure class="ai-gt ai-tt" data-tritontiles>
  <div class="ai-ms-title">{title}</div>
  <div class="ai-tl-ctl">
    <div class="ai-gt-pre ai-pc-sets" data-group="m"><button data-v="vec" aria-pressed="true">向量：融合的 SwiGLU</button><button data-v="mm" aria-pressed="false">矩阵乘法</button></div>
    <div data-ctl-vec class="ai-tl-ctl">
      <label class="ai-tl-lr"><span>n = <b data-nv></b></span><input type="range" min="100" max="1200" step="50" value="1000" data-n /></label>
      <div class="ai-gt-pre ai-pc-sets" data-group="bl"><span class="ai-tl-k">BLOCK：</span><button data-v="128" aria-pressed="false">128</button><button data-v="256" aria-pressed="true">256</button><button data-v="512" aria-pressed="false">512</button></div>
    </div>
    <div data-ctl-mm class="ai-tl-ctl" hidden>
      <label class="ai-tl-lr"><span>沿 K 的第 <b data-kv></b> 块</span><input type="range" min="0" max="3" step="1" value="0" data-k /></label>
    </div>
  </div>
  <div class="ai-tt-wrap">
    <pre class="ai-tt-code" data-code></pre>
    <div class="ai-tt-pic" data-pic></div>
  </div>
  <div class="ai-cg-eq" data-eq></div>
  {caption && <figcaption class="ai-fig-cap">{caption}</figcaption>}
</figure>

<script>
  const VEC = ['@triton.jit', 'def silu_mul(g_ptr, u_ptr, y_ptr, n, BLOCK: tl.constexpr):', '    pid = tl.program_id(0)', '    offs = pid * BLOCK + tl.arange(0, BLOCK)', '    mask = offs < n', '    g = tl.load(g_ptr + offs, mask=mask)', '    u = tl.load(u_ptr + offs, mask=mask)', '    y = g * tl.sigmoid(g) * u', '    tl.store(y_ptr + offs, y, mask=mask)'];
  const MM = ['@triton.jit', 'def matmul(a_ptr, b_ptr, c_ptr, K, ..., BM, BN, BK):', '    pid_m, pid_n = tl.program_id(0), tl.program_id(1)', '    rm = pid_m * BM + tl.arange(0, BM)', '    rn = pid_n * BN + tl.arange(0, BN)', '    acc = tl.zeros((BM, BN), dtype=tl.float32)', '    for k in range(0, K, BK):', '        a = tl.load(A 的 rm 行、k..k+BK 列)', '        b = tl.load(B 的 k..k+BK 行、rn 列)', '        acc += tl.dot(a, b)', '    tl.store(C 的 rm 行、rn 列, acc)'];
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  function init(fig: HTMLElement) {
    let mode = 'vec', BL = 256, pid = 3, pm = 1, pn = 2;
    const nIn = fig.querySelector<HTMLInputElement>('[data-n]')!, kIn = fig.querySelector<HTMLInputElement>('[data-k]')!;
    const code = (lines: string[], hl: number[]) => lines.map((l, i) => `<span class="${hl.includes(i) ? 'is-hl' : ''}">${esc(l)}</span>`).join('\n');
    function draw() {
      fig.querySelector<HTMLElement>('[data-ctl-vec]')!.hidden = mode !== 'vec'; fig.querySelector<HTMLElement>('[data-ctl-mm]')!.hidden = mode !== 'mm';
      const pic = fig.querySelector<HTMLElement>('[data-pic]')!, eq = fig.querySelector<HTMLElement>('[data-eq]')!, cd = fig.querySelector<HTMLElement>('[data-code]')!;
      if (mode === 'vec') {
        const n = Number(nIn.value), grid = Math.ceil(n / BL); if (pid >= grid) pid = grid - 1;
        fig.querySelector('[data-nv]')!.textContent = String(n);
        const total = grid * BL, sc = 260 / total;
        let s = `<svg class="ai-tl-svg" viewBox="0 0 280 ${grid * 26 + 30}">`;
        for (let p = 0; p < grid; p++) {
          const valid = Math.min(BL, n - p * BL);
          s += `<g data-p="${p}" class="ai-tt-prog${p === pid ? ' is-sel' : ''}"><text class="ai-al-gl" x="4" y="${p * 26 + 18}">程序 ${p}</text><rect class="ai-tt-ok" x="54" y="${p * 26 + 6}" width="${valid / BL * 220}" height="18"/>${valid < BL ? `<rect class="ai-tt-mask" x="${54 + valid / BL * 220}" y="${p * 26 + 6}" width="${(BL - valid) / BL * 220}" height="18"/>` : ''}</g>`;
        }
        s += `<text class="ai-al-gl" x="54" y="${grid * 26 + 20}">每行一个程序（${BL} 个位置），灰色 = mask 为假</text>`;
        pic.innerHTML = s + '</svg>';
        cd.innerHTML = code(VEC, [2, 3, 4]);
        const lo = pid * BL, hi = lo + BL - 1, valid = Math.min(BL, n - lo);
        eq.innerHTML = `网格 = ⌈${n} / ${BL}⌉ = ${grid} 个程序（总位置 ${total} 个，${total - n} 个被 mask 掉）。点左边的一行选程序。`
          + `<br>程序 ${pid}：offs = ${pid} × ${BL} + [0, 1, …, ${BL - 1}] = [${lo}, …, ${hi}]；mask = offs &lt; ${n} → ${valid} 个为真${valid < BL ? `，后 ${BL - valid} 个不读不写` : ''}`
          + '<br><span class="ai-faint">一个程序就是 CUDA 里的一个线程块，但我们只写“这一块数据做什么”，块里的线程怎么分工、warp、合并访存，都由编译器处理。</span>';
      } else {
        const BM = 32, BN = 16, BK = 16, k = Number(kIn.value), cs = 3;
        fig.querySelector('[data-kv]')!.textContent = `${k + 1} / 4`;
        const box = (x: number, y: number, w: number, h: number, cls: string) => `<rect class="${cls}" x="${x}" y="${y}" width="${w}" height="${h}"/>`;
        let s = '<svg class="ai-tl-svg" viewBox="0 0 290 270">';
        // A 在左下，B 在右上，C 在右下
        const Ax = 10, Ay = 80, Bx = 90, By = 4, Cx = 90, Cy = 80;
        s += box(Ax, Ay, 64, 192, 'ai-tt-mat') + box(Bx, By, 192, 64, 'ai-tt-mat') + box(Cx, Cy, 192, 192, 'ai-tt-mat');
        for (let i = 0; i < 2; i++) for (let j = 0; j < 4; j++) s += `<g data-pmn="${i},${j}">${box(Cx + j * BN * cs, Cy + i * BM * cs, BN * cs, BM * cs, `ai-tt-cell${i === pm && j === pn ? ' is-sel' : ''}`)}</g>`;
        s += box(Ax + k * BK, Ay + pm * BM * cs, BK, BM * cs, 'ai-tt-a') + box(Bx + pn * BN * cs, By + k * BK, BN * cs, BK, 'ai-tt-b');
        s += `<text class="ai-al-gl" x="${Ax}" y="${Ay - 4}">A（64×64）</text><text class="ai-al-gl" x="${Bx - 4}" y="${By + 40}" text-anchor="end">B</text><text class="ai-al-gl" x="${Cx + 4}" y="${Cy + 186}">C：点一块选程序</text>`;
        pic.innerHTML = s + '</svg>';
        cd.innerHTML = code(MM, k === 3 ? [7, 8, 9, 10] : [7, 8, 9]);
        eq.innerHTML = `网格 = (64 / ${BM}, 64 / ${BN}) = (2, 4)，8 个程序。选中的程序 (${pm}, ${pn}) 负责 C 的第 ${pm * BM}–${pm * BM + BM - 1} 行、第 ${pn * BN}–${pn * BN + BN - 1} 列。`
          + `<br>第 ${k + 1} 次循环：取 A 的这些行、第 ${k * BK}–${k * BK + BK - 1} 列，B 的第 ${k * BK}–${k * BK + BK - 1} 行、这些列，tl.dot 相乘，加到 acc 上${k === 3 ? '；循环结束，把 acc 写回 C' : ''}。`
          + '<br><span class="ai-faint">这就是第 86 讲的分块矩阵乘法：A、B 的小块搬进片上、被复用；共享内存怎么分配、tl.dot 怎么交给 Tensor Core，编译器来做。</span>';
      }
    }
    fig.addEventListener('input', draw);
    fig.addEventListener('click', (e) => {
      const t = e.target as Element, b = t.closest<HTMLElement>('[data-group] [data-v]'), p = t.closest<SVGGElement>('[data-p]'), c = t.closest<SVGGElement>('[data-pmn]');
      if (b) { const g = b.closest<HTMLElement>('[data-group]')!; g.querySelectorAll('[data-v]').forEach((x) => x.setAttribute('aria-pressed', x === b ? 'true' : 'false')); if (g.dataset.group === 'm') mode = b.dataset.v!; else BL = Number(b.dataset.v); }
      else if (p) pid = Number(p.dataset.p);
      else if (c) [pm, pn] = c.dataset.pmn!.split(',').map(Number);
      else return;
      draw();
    });
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-tritontiles]').forEach(init);
</script>
