---
// MoE 路由：24 个 token、8 个专家。路由器给每个 token 对每个专家打分，选分最高的 k 个；被选中的专家按 softmax 权重加权。
// 读者可以：调 k；点“均衡一步 / 自动均衡”调每个专家的偏置（思路同 DeepSeek-V3；这里按偏离平均的比例调，DeepSeek-V3 原文按正负号固定步长调）（太忙的调低、太闲的调高，偏置只影响“选谁”）；
//   点某一行看这个 token 的打分和权重。token 向量和路由器权重用固定种子随机生成，故意带一点偏向，让负载一开始不均匀。
interface Props { title?: string; caption?: string }
const { title = '路由器给每个 token 选专家', caption } = Astro.props;
---
<figure class="ai-gt ai-moe" data-moe>
  <div class="ai-ms-title">{title}</div>
  <div class="ai-tl-ctl">
    <div class="ai-gt-pre ai-pc-sets" data-group="k"><span class="ai-tl-k">每个 token 选几个专家 k</span>{[1, 2, 4].map((v) => <button data-v={v} aria-pressed={v === 2 ? 'true' : 'false'}>{v}</button>)}</div>
    <div class="ai-gt-pre ai-pc-sets"><button data-act="bal">均衡一步</button><button data-act="auto">自动均衡 20 步</button><button data-act="reset">偏置清零</button></div>
  </div>
  <div class="ai-moe-body">
    <div class="ai-moe-grid" data-grid></div>
    <div class="ai-moe-side"><div class="ai-mlp-pt">每个专家接到的 token 数</div><div data-load></div><div class="ai-vp-read" data-read></div></div>
  </div>
  {caption && <figcaption class="ai-fig-cap">{caption}</figcaption>}
</figure>

<script>
  const rng = (seed: number) => () => { seed |= 0; seed = (seed + 0x6d2b79f5) | 0; let t = Math.imul(seed ^ (seed >>> 15), 1 | seed); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
  const normal = (r: () => number) => Math.sqrt(-2 * Math.log(1 - r())) * Math.cos(2 * Math.PI * r());
  const fmt = (v: number, d = 2) => { const k = 10 ** d; v = Math.round(v * k) / k; if (Object.is(v, -0)) v = 0; return v < 0 ? '−' + -v : String(v); };
  const N = 24, E = 8, D = 16;
  function init(fig: HTMLElement) {
    const r = rng(41);
    const shift = Array.from({ length: D }, () => normal(r) * 0.8);
    const X = Array.from({ length: N }, () => Array.from({ length: D }, (_, j) => normal(r) + shift[j]));
    const W = Array.from({ length: D }, () => Array.from({ length: E }, () => normal(r) / 4));
    const logits = X.map((x) => W[0].map((_, e) => x.reduce((s, v, j) => s + v * W[j][e], 0)));
    let k = 2, bias = new Array(E).fill(0), sel = 0;
    const choose = () => logits.map((l) => l.map((v, e) => [v + bias[e], e]).sort((a, b) => b[0] - a[0]).slice(0, k).map((x) => x[1]));
    const balance = () => { const ch = choose(), ld = new Array(E).fill(0); ch.flat().forEach((e) => ld[e]++); const m = ld.reduce((a, b) => a + b, 0) / E; bias = bias.map((b, e) => b - 0.15 * (ld[e] - m) / m); };   // 按偏离平均的比例调整
    function draw() {
      const ch = choose(), ld = new Array(E).fill(0);
      ch.flat().forEach((e) => ld[e]++);
      let g = `<table class="ai-att-tbl ai-moe-tbl"><thead><tr><th></th>${Array.from({ length: E }, (_, e) => `<th>专家${e + 1}</th>`).join('')}</tr></thead><tbody>`;
      logits.forEach((l, i) => {
        const p = l.map((v) => Math.exp(v)), s = p.reduce((a, b) => a + b, 0);
        g += `<tr data-row="${i}" class="${i === sel ? 'is-sel' : ''}"><th>token ${i + 1}</th>${l.map((v, e) => `<td class="${ch[i].includes(e) ? 'is-pick' : ''}" style="--a:${(p[e] / s).toFixed(3)}">${ch[i].includes(e) ? '●' : ''}</td>`).join('')}</tr>`;
      });
      fig.querySelector<HTMLElement>('[data-grid]')!.innerHTML = g + '</tbody></table>';
      const mean = (N * k) / E, mx = Math.max(...ld);
      fig.querySelector<HTMLElement>('[data-load]')!.innerHTML = ld.map((v, e) => `<div class="ai-moe-lrow"><span>专家${e + 1}</span><span class="ai-mc-bar"><i style="width:${(v / Math.max(mx, 1) * 100).toFixed(0)}%"></i></span><b>${v}</b><small>偏置 ${fmt(bias[e])}</small></div>`).join('')
        + `<div class="ai-vp-hint" style="margin-top:6px">平均每个专家 ${fmt(mean, 1)} 个；最忙 / 平均 = <b>${fmt(mx / mean)}</b>；${ld.filter((v) => v === 0).length} 个专家完全闲着</div>`;
      const l = logits[sel], c = ch[sel], z = c.map((e) => l[e]), m = Math.max(...z), w = z.map((v) => Math.exp(v - m)), ws = w.reduce((a, b) => a + b, 0);
      fig.querySelector<HTMLElement>('[data-read]')!.innerHTML = `<div class="ai-vp-row"><span>token ${sel + 1}</span><div>打分：${l.map((v, e) => `${e + 1}:${fmt(v)}`).join('  ')}</div></div>`
        + `<div class="ai-vp-row"><span>选中</span><div>${c.map((e, j) => `专家${e + 1}（权重 ${fmt(w[j] / ws)}）`).join('，')}</div></div>`
        + `<div class="ai-vp-row ai-vp-hint">输出 = ${c.map((e, j) => `${fmt(w[j] / ws)} × 专家${e + 1}(x)`).join(' + ')}。其余 ${E - k} 个专家对这个 token 完全不计算。</div>`;
    }
    fig.addEventListener('click', (ev) => {
      const t = ev.target as HTMLElement, kb = t.closest<HTMLElement>('[data-group="k"] [data-v]'), act = t.closest<HTMLElement>('[data-act]')?.dataset.act, row = t.closest<HTMLElement>('[data-row]');
      if (kb) { k = Number(kb.dataset.v); fig.querySelectorAll('[data-group="k"] [data-v]').forEach((x) => x.setAttribute('aria-pressed', x === kb ? 'true' : 'false')); }
      else if (act === 'bal') balance();
      else if (act === 'auto') { for (let i = 0; i < 20; i++) balance(); }
      else if (act === 'reset') bias = new Array(E).fill(0);
      else if (row) sel = Number(row.dataset.row);
      else return;
      draw();
    });
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-moe]').forEach(init);
</script>
