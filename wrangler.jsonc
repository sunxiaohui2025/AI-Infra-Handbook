{
  // 纯静态 Astro 站点：交给 Cloudflare Workers 静态资源托管。
  // 只要有这个配置文件，`wrangler deploy` 就不再自动检测框架/运行 astro add cloudflare，
  // 而是直接把 dist/ 作为静态资源部署。站点不需要 @astrojs/cloudflare 适配器。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-infra-handbook",
  "compatibility_date": "2026-11-10",
  "assets": {
    // assets-only Worker 不能带 binding，只指定目录即可
    "directory": "./dist"
  }
}
