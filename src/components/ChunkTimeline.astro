---
// Chunked Prefill 时间线（Llama-3-8B + H100 理想值，公式与第 77 讲的代码相同）。
// 32 个请求正在 decode（上下文各约 1000 个 token），第 2 步之后来了一个长提示。
// 每一步的 token 预算：先给 32 个 decode 各留 1 个，剩下的给长提示的 prefill（切块）；“不切块”就是一步做完整段 prefill。
// 上图固定是“不切块”，下图是选中的预算，时间轴相同。每一格是一步，宽度 = 这一步的耗时；琥珀色的步里带着 prefill。
// 下面一排小竖线是某个 decode 请求每生成 1 个 token 的时刻，竖线之间的间隔就是它的 TPOT。
interface Props { title?: string; caption?: string }
const { title = '长提示插进来：切块前后', caption } = Astro.props;
---
<figure class="ai-gt ai-ck" data-chunktl>
  <div class="ai-ms-title">{title}</div>
  <div class="ai-tl-ctl">
    <div class="ai-gt-pre ai-pc-sets" data-group="b"><span class="ai-tl-k">每步的 token 预算：</span><button data-v="2048" aria-pressed="false">2048</button><button data-v="1024" aria-pressed="false">1024</button><button data-v="512" aria-pressed="true">512</button><button data-v="256" aria-pressed="false">256</button></div>
    <label class="ai-tl-lr"><span>长提示 = <b data-pv></b> 个 token</span><input type="range" min="2000" max="16000" step="1000" value="8000" data-p /></label>
  </div>
  <div data-charts></div>
  <div class="ai-cg-eq" data-eq></div>
  {caption && <figcaption class="ai-fig-cap">{caption}</figcaption>}
</figure>

<script>
  const N = 8.03e9, NE = 128256 * 4096, L = 32, d = 4096, W = N * 2, KV = 2 * 32 * 8 * 128 * 2, F = 989e12, BW = 3.35e12;
  const D = 32, CTX = 1000;
  const stepMs = (dec: number, pre: number, preCtx: number) => {
    const flops = 2 * (N - NE) * (dec + pre) + 4 * L * d * (dec * CTX + pre * (preCtx + pre / 2));
    const bytes = W + KV * (dec * CTX + preCtx + pre);
    return Math.max(flops / F, bytes / BW) * 1e3;
  };
  type Step = { t0: number; ms: number; pre: number };
  function run(P: number, budget: number) {
    const steps: Step[] = []; let t = 0, done = 0, ttft = 0, worst = 0, nPre = 0;
    for (let k = 0; k < 2; k++) { const ms = stepMs(D, 0, 0); steps.push({ t0: t, ms, pre: 0 }); t += ms; }
    while (done < P) { const c = Math.min(budget - D, P - done); const ms = stepMs(D, c, done); steps.push({ t0: t, ms, pre: c }); t += ms; done += c; worst = Math.max(worst, ms); nPre++; }
    ttft = t - steps[1].t0 - steps[1].ms;
    return { steps, ttft, worst, nPre, end: t };
  }
  function init(fig: HTMLElement) {
    let budget = 512;
    const pIn = fig.querySelector<HTMLInputElement>('[data-p]')!;
    function chart(name: string, r: ReturnType<typeof run>, T: number) {
      const Lx = 8, Rx = 592, sc = (Rx - Lx) / T, H = 92;
      let s = `<svg class="ai-tl-svg" viewBox="0 0 600 ${H}"><text class="ai-np-ptitle" x="${Lx}" y="12">${name}：长提示的 TTFT ${r.ttft.toFixed(1)} ms，decode 请求最长的 TPOT ${r.worst.toFixed(1)} ms</text>`;
      let t = r.end; const steps = [...r.steps]; while (t < T) { const ms = stepMs(D, 0, 0); steps.push({ t0: t, ms, pre: 0 }); t += ms; }
      for (const st of steps) {
        if (st.t0 >= T) break;
        const w = Math.min(st.ms, T - st.t0) * sc;
        s += `<g><title>${st.ms.toFixed(1)} ms：32 个 decode${st.pre ? ` + ${st.pre} 个 prefill token` : ''}</title><rect class="${st.pre ? 'ai-ck-pre' : 'ai-ck-dec'}" x="${Lx + st.t0 * sc + 0.4}" y="22" width="${Math.max(0.6, w - 0.8)}" height="26"/></g>`;
        if (st.t0 + st.ms <= T) s += `<line class="ai-ck-tick" x1="${Lx + (st.t0 + st.ms) * sc}" x2="${Lx + (st.t0 + st.ms) * sc}" y1="56" y2="68"/>`;
      }
      const ft = Lx + r.end * sc;
      s += `<line class="ai-ck-ft" x1="${ft}" x2="${ft}" y1="18" y2="52"/><text class="ai-al-gl" x="${Math.min(ft + 3, 520)}" y="84">长提示的第 1 个 token</text><text class="ai-al-gl" x="${Lx}" y="84">↑ 每条竖线：某个 decode 请求出了 1 个 token</text>`;
      return s + '</svg>';
    }
    function draw() {
      const P = Number(pIn.value);
      fig.querySelector('[data-pv]')!.textContent = String(P);
      const a = run(P, P + D), b = run(P, budget), T = Math.max(a.end, b.end) * 1.12;
      fig.querySelector<HTMLElement>('[data-charts]')!.innerHTML = chart('不切块', a, T) + chart(`每步预算 ${budget}`, b, T);
      const base = stepMs(D, 0, 0);
      fig.querySelector<HTMLElement>('[data-eq]')!.innerHTML = `平时一步（32 个 decode）≈ ${base.toFixed(2)} ms。不切块：整段 prefill 塞进一步，耗时 ${a.worst.toFixed(1)} ms，这一步里 32 个请求都在干等。`
        + `<br>预算 ${budget}：每步先给 32 个 decode，再切 ${budget - D} 个 prefill token，分 ${b.nPre} 步做完；每步最长 ${b.worst.toFixed(1)} ms，这期间每个 decode 请求出了 ${b.nPre} 个 token（不切块只出 1 个）。`
        + `<br><span class="ai-faint">长提示的 TTFT 从 ${a.ttft.toFixed(1)} ms 变成 ${b.ttft.toFixed(1)} ms。预算太小，每步都要把权重读一遍，步数多了，TTFT 会明显变长（试试 256）。</span>`;
    }
    pIn.addEventListener('input', draw);
    fig.addEventListener('click', (e) => {
      const bt = (e.target as HTMLElement).closest<HTMLElement>('[data-group="b"] [data-v]'); if (!bt) return;
      budget = Number(bt.dataset.v); fig.querySelectorAll('[data-group="b"] [data-v]').forEach((x) => x.setAttribute('aria-pressed', x === bt ? 'true' : 'false')); draw();
    });
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-chunktl]').forEach(init);
</script>
