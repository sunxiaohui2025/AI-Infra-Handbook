---
// 留言板：匿名提交反馈（无需注册），下方公开展示所有留言与管理员回复。
// 提交写入 /api/feedback；列表读取公开接口 /api/board（不含联系方式等隐私字段）。
---
<div class="ai-board" id="ai-board">
  <div class="ai-fb" id="ai-fb">
    <p class="ai-fb-intro">遇到讲不清楚、图错了、链接打不开，或想提改进建议，都可以在这里留言。无需注册。</p>

    <form id="ai-fb-form" novalidate>
      <div class="ai-fb-kind" role="radiogroup" aria-label="留言类型">
        {[
          { v: 'bug', t: '内容有误/打不开' },
          { v: 'suggest', t: '改进建议' },
          { v: 'praise', t: '表扬' },
          { v: 'other', t: '其他' },
        ].map((k) => (
          <label class="ai-fb-kopt">
            <input type="radio" name="kind" value={k.v} checked={k.v === 'suggest'} />
            <span>{k.t}</span>
          </label>
        ))}
      </div>

      <label class="ai-fb-field">
        <span>留言内容 <i>*</i></span>
        <textarea name="content" rows="5" required placeholder="例如：第 12 讲这张图的坐标标错了…"></textarea>
      </label>

      <label class="ai-fb-field">
        <span>联系方式（选填，不会公开）</span>
        <input type="text" name="contact" placeholder="邮箱 / 微信，方便我私下联系你；不填也能提交" />
      </label>

      <div class="ai-fb-actions">
        <button type="submit" class="ai-fb-submit">发表留言</button>
        <span class="ai-fb-status" role="status"></span>
      </div>
    </form>
  </div>

  <div class="ai-board-head">
    <h2>大家的留言</h2>
    <span class="ai-board-count" id="ai-board-count"></span>
  </div>
  <div class="ai-board-list" id="ai-board-list">
    <p class="ai-board-empty">正在加载…</p>
  </div>
</div>

<style>
  .ai-board { max-width: 720px; margin: 0 auto; }
  .ai-fb { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 26px 26px 24px; box-shadow: 0 8px 30px rgba(0,0,0,.04); }
  .ai-fb-intro { margin: 0 0 18px; color: #6b7280; font-size: 14px; }
  .ai-fb-kind { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .ai-fb-kopt input { position: absolute; opacity: 0; }
  .ai-fb-kopt span { display: inline-block; padding: 7px 14px; border-radius: 999px; border: 1px solid #d1d5db; color: #374151; cursor: pointer; font-size: 13px; user-select: none; transition: all .15s; }
  .ai-fb-kopt input:checked + span { background: #16193c; border-color: #16193c; color: #fff; }
  .ai-fb-field { display: block; margin-bottom: 16px; }
  .ai-fb-field > span { display: block; font-size: 13px; color: #374151; margin-bottom: 6px; }
  .ai-fb-field > span i { color: #d33; font-style: normal; }
  .ai-fb-field textarea, .ai-fb-field input[type="text"] { width: 100%; border: 1px solid #d1d5db; border-radius: 10px; padding: 10px 12px; font-size: 14px; font-family: inherit; background: #fff; color: #111827; box-sizing: border-box; }
  .ai-fb-field textarea:focus, .ai-fb-field input[type="text"]:focus { outline: none; border-color: #16193c; box-shadow: 0 0 0 3px rgba(22,25,60,.08); }
  .ai-fb-actions { display: flex; align-items: center; gap: 12px; }
  .ai-fb-submit { background: #16193c; color: #fff; border: none; padding: 11px 22px; border-radius: 10px; cursor: pointer; font-size: 14px; }
  .ai-fb-submit:hover { background: #262b5e; }
  .ai-fb-submit:disabled { opacity: .6; cursor: default; }
  .ai-fb-status { font-size: 13px; color: #6b7280; }
  .ai-fb-status.ok { color: #059669; }
  .ai-fb-status.err { color: #d33; }

  .ai-board-head { display: flex; align-items: baseline; gap: 10px; margin: 38px 0 14px; }
  .ai-board-head h2 { font-size: 19px; margin: 0; }
  .ai-board-count { font-size: 13px; color: #9ca3af; }
  .ai-board-list { display: flex; flex-direction: column; gap: 12px; }
  .ai-board-empty { color: #9ca3af; font-size: 14px; text-align: center; padding: 26px 0; }

  .ai-msg { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 16px 18px; }
  .ai-msg-top { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .ai-msg-kind { font-size: 12px; padding: 2px 9px; border-radius: 999px; background: #eef0f6; color: #4b5563; }
  .ai-msg-kind.k-bug { background: #fdecec; color: #b91c1c; }
  .ai-msg-kind.k-suggest { background: #eef2ff; color: #3730a3; }
  .ai-msg-kind.k-praise { background: #ecfdf5; color: #047857; }
  .ai-msg-time { font-size: 12px; color: #9ca3af; margin-left: auto; }
  .ai-msg-content { margin: 0; font-size: 14px; line-height: 1.75; color: #1f2937; white-space: pre-wrap; word-break: break-word; }
  .ai-msg-reply { margin-top: 12px; padding: 12px 14px; background: #f8fafc; border-left: 3px solid #16193c; border-radius: 8px; }
  .ai-reply-label { display: inline-block; font-size: 12px; font-weight: 600; color: #16193c; margin-bottom: 4px; }
  .ai-reply-label::before { content: '管理员回复 · '; font-weight: 400; color: #9ca3af; }
  .ai-msg-reply p { margin: 0; font-size: 13.5px; line-height: 1.7; color: #374151; white-space: pre-wrap; word-break: break-word; }
  .ai-msg-wait { margin-top: 10px; font-size: 12px; color: #9ca3af; }
</style>

<script>
  import { sendFeedback } from '../data/anon';
  import { backendUrl } from '../data/site';

  const form = document.getElementById('ai-fb-form') as HTMLFormElement | null;
  const status = document.querySelector('.ai-fb-status') as HTMLElement | null;
  const submitBtn = form?.querySelector('.ai-fb-submit') as HTMLButtonElement | null;
  const listEl = document.getElementById('ai-board-list');
  const countEl = document.getElementById('ai-board-count');

  const KIND_CN: Record<string, string> = { bug: '问题', suggest: '建议', praise: '表扬', other: '其他' };

  function esc(s: unknown): string {
    return String(s ?? '').replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[c]
    );
  }
  function fmtTime(iso: string): string {
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    const p = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
  }

  function renderList(items: any[]) {
    if (!listEl) return;
    if (!items || !items.length) {
      listEl.innerHTML = '<p class="ai-board-empty">还没有留言，欢迎你来说第一句。</p>';
      if (countEl) countEl.textContent = '';
      return;
    }
    if (countEl) countEl.textContent = `共 ${items.length} 条`;
    listEl.innerHTML = items
      .map((m) => {
        const kind = esc(m.kind || 'other');
        const kindText = esc(KIND_CN[m.kind] || '其他');
        const reply = (m.reply || '').trim();
        const replyHtml = reply
          ? `<div class="ai-msg-reply">
               <span class="ai-reply-label">${esc(fmtTime(m.reply_at))}</span>
               <p>${esc(reply)}</p>
             </div>`
          : `<div class="ai-msg-wait">待管理员回复</div>`;
        return `<article class="ai-msg">
            <div class="ai-msg-top">
              <span class="ai-msg-kind k-${kind}">${kindText}</span>
              <span class="ai-msg-time">${esc(fmtTime(m.ts))}</span>
            </div>
            <p class="ai-msg-content">${esc(m.content)}</p>
            ${replyHtml}
          </article>`;
      })
      .join('');
  }

  async function loadBoard() {
    try {
      const r = await fetch(backendUrl('/api/board?limit=100'));
      const d = await r.json();
      renderList(d.list || []);
    } catch {
      if (listEl) listEl.innerHTML = '<p class="ai-board-empty">留言暂时加载不出来，稍后再刷新看看。</p>';
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const content = ((fd.get('content') as string) || '').trim();
    const kind = (fd.get('kind') as string) || 'other';
    const contact = ((fd.get('contact') as string) || '').trim();
    if (!content) {
      if (status) { status.textContent = '请填写留言内容'; status.className = 'ai-fb-status err'; }
      return;
    }
    if (submitBtn) submitBtn.disabled = true;
    if (status) { status.textContent = '提交中…'; status.className = 'ai-fb-status'; }
    try {
      const r = await sendFeedback({ kind, content, contact, page: location.pathname });
      if (r && r.ok) {
        if (status) { status.textContent = '✅ 留言已发布，谢谢！'; status.className = 'ai-fb-status ok'; }
        form.reset();
        await loadBoard();
      } else {
        if (status) { status.textContent = '提交失败，请稍后再试'; status.className = 'ai-fb-status err'; }
      }
    } catch {
      if (status) { status.textContent = '提交失败（后端未连接？），请稍后再试'; status.className = 'ai-fb-status err'; }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });

  loadBoard();
</script>
