---
// 矩阵乘的工程账：输入 s、k、n、精度 → FLOPs、权重字节、每字节 FLOPs（算术强度，只计读权重）。
---
<div class="ai-calc" data-calc>
  <div class="ai-calc-in">
    <label>token 数 s<input data-c="s" value="1" inputmode="numeric" /></label>
    <label>输入维度 k<input data-c="k" value="4096" inputmode="numeric" /></label>
    <label>输出维度 n<input data-c="n" value="4096" inputmode="numeric" /></label>
    <label>权重精度
      <select data-c="b">
        <option value="4">FP32 · 4 字节</option>
        <option value="2" selected>BF16 · 2 字节</option>
        <option value="1">FP8 · 1 字节</option>
      </select>
    </label>
  </div>
  <div class="ai-calc-pre">
    <span>预设</span>
    <button data-p="1">逐词生成 s = 1</button>
    <button data-p="1000">读完长提示 s = 1000</button>
    <button data-p="tiny">TinyLM 手算例</button>
  </div>
  <div class="ai-eng">
    <div><b data-o="f"></b>FLOPs = 2·s·k·n</div>
    <div><b data-o="w"></b>权重 = k·n·字节数</div>
    <div><b data-o="i"></b>每读 1 字节权重的 FLOPs</div>
  </div>
  <div class="ai-ms-note">只计读权重；激活和 KV cache 占的显存在第 63 讲展开</div>
</div>

<script>
  function init(box: HTMLElement) {
    const inp = (k: string) => box.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-c="${k}"]`)!;
    const g = (k: string) => { const v = parseFloat(inp(k).value); return isNaN(v) || v < 0 ? 0 : v; };
    const out = (k: string) => box.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const sci = (x: number) => {
      if (x < 1e5) return String(Math.round(x * 10) / 10);
      const e = Math.floor(Math.log10(x));
      return (x / Math.pow(10, e)).toFixed(1) + '×10<sup>' + e + '</sup>';
    };
    const bytes = (x: number) => {
      if (x < 1024) return x + ' B';
      if (x < 1048576) return Math.round((x / 1024) * 10) / 10 + ' KiB';
      if (x < 1073741824) return Math.round((x / 1048576) * 10) / 10 + ' MiB';
      return Math.round((x / 1073741824) * 10) / 10 + ' GiB';
    };
    function draw() {
      const s = g('s'), k = g('k'), n = g('n'), b = g('b'), f = 2 * s * k * n, w = k * n * b;
      out('f').innerHTML = sci(f);
      out('w').textContent = bytes(w);
      out('i').textContent = w ? String(Math.round((f / w) * 10) / 10) : '—';
    }
    box.addEventListener('input', draw);
    box.addEventListener('change', draw);
    box.addEventListener('click', (e) => {
      const p = (e.target as HTMLElement).closest<HTMLElement>('[data-p]');
      if (!p) return;
      const v = p.dataset.p!;
      const set = (k: string, x: string | number) => { inp(k).value = String(x); };
      if (v === 'tiny') { set('s', 4); set('k', 4); set('n', 4); set('b', '4'); }
      else { set('s', v); set('k', 4096); set('n', 4096); set('b', '2'); }
      draw();
    });
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-calc]').forEach(init);
</script>
