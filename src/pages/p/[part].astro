---
// 篇页：居中两栏，左侧本章目录，右侧本篇讲列表。
import Base from '../../layouts/Base.astro';
import SideNav from '../../components/SideNav.astro';
import { CH, PN, partLs, chOf, chName, pad, fastCount, prevNextPart } from '../../data/course';

export function getStaticPaths() {
  return Object.keys(PN).map((p) => ({ params: { part: p } }));
}

const p = Number(Astro.params.part);
const ls = partLs(p);
const c = CH[chOf(p) - 1];
const nk = ls.filter((l) => l.key).length;
const no = ls.filter((l) => l.opt).length;
const first = ls.find((l) => l.fast) || ls[0];
const { prev: prevPart, next: nextPart } = prevNextPart(p);
---
<Base title={`第 ${p} 篇 ${PN[p]}`} view="part">
  <main class="ai-scroll" id="main">
    <div class="ai-shell">
      <SideNav ch={c.n} part={p} />
      <div class="ai-shell-main">
        <div class="ai-page">
          <nav class="ai-crumb"><a href="/">学习路线</a><span>/</span><span>{chName(c)}</span></nav>
          <h1>第 {p} 篇 {PN[p]}</h1>
          <p class="ai-page-intro">{c.intro}</p>
          <div class="ai-page-meta">
            <a class="ai-btn-primary" href={`/l/${ls[0].id}`}>从 {pad(ls[0].id)} 开始 →</a>
            <span>
              {ls.length} 讲 · 重点 {nk} · {p === 6 ? '整篇选学' : `选读 ${no}`}
              <span class="r-fast"> · 快速路线读 {fastCount(ls)}{first.id !== ls[0].id ? `（从 ${pad(first.id)} 起）` : ''}</span>
            </span>
          </div>
          <div class="ai-list">
            {ls.map((l) => (
              <a class="ai-lrow" href={`/l/${l.id}`} data-skip={l.fast ? undefined : '1'}>
                <span class="ai-num">{pad(l.id)}</span>
                <span><div class="ai-lrow-title">{l.title}</div><div class="ai-lrow-q">{l.q}</div></span>
                <span class="ai-lrow-go">→</span>
              </a>
            ))}
          </div>
          <div class="ai-pn">
            {prevPart ? <a href={`/p/${prevPart}`}><small>上一篇</small>← 第 {prevPart} 篇 {PN[prevPart]}</a> : <span></span>}
            {nextPart ? <a href={`/p/${nextPart}`}><small>下一篇</small>第 {nextPart} 篇 {PN[nextPart]} →</a> : <span></span>}
          </div>
        </div>
      </div>
    </div>
  </main>
</Base>
