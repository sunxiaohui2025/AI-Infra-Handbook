---
// 两条加速器路线的卡内结构（第六章，第 135 讲）：
//   gpgpu：卡 → 若干计算单元（SM / CU），单元内是 SIMT 的向量通道 + 矩阵核心 + 寄存器 + 共享内存，卡级有 L2、HBM、互联端口。
//   npu：卡 → 若干 AI 核，核内分成标量、向量、矩阵三类单元和几级片上缓冲，数据靠搬运单元显式搬进搬出。
// 结构和分工按两条路线的公开资料画成示意图，不代表任何一款具体型号的尺寸比例；具体规格以官方文档为准。
// 读者可以：切换路线，点任意部件看它负责什么、换卡时和 CUDA 的对应关系。
interface Props { route?: 'gpgpu' | 'npu'; title?: string; caption?: string }
const { route = 'gpgpu', title = '一块加速器里面有什么', caption } = Astro.props;
---
<figure class="ai-gt ai-aa" data-accelarch data-route={route}>
  <div class="ai-ms-title">{title}</div>
  <div class="ai-gt-pre ai-pc-sets" data-group="r"><button data-r="gpgpu">GPGPU（SIMT）</button><button data-r="npu">NPU / DSA（显式搬运）</button></div>
  <div data-svg></div>
  <div class="ai-cg-eq" data-eq></div>
  {caption && <figcaption class="ai-fig-cap">{caption}</figcaption>}
</figure>

<script>
  type Part = { k: string; t: string; x: number; y: number; w: number; h: number; cls: string; d: string };
  type View = { note: string; parts: Part[] };
  const VIEWS: Record<string, View> = {
    gpgpu: {
      note: '编程模型：一个 kernel 启动成千上万个线程，每 w 个线程编成一个线程组（NVIDIA 的 warp 是 32，AMD 和海光的波前是 64），组内所有线程同一拍执行同一条指令。搬数据也由线程自己写：从显存读到寄存器，或者读到共享内存再彼此共享。',
      parts: [
        { k: 'hbm', t: '显存 HBM', x: 8, y: 8, w: 180, h: 34, cls: 'net', d: '容量几十到几百 GB，带宽几 TB/s。第 62 讲的 Roofline 里，它的带宽是那条斜线的斜率。' },
        { k: 'l2', t: 'L2 缓存（全卡共享）', x: 8, y: 50, w: 180, h: 28, cls: 'sw', d: '几十 MB。多个计算单元读同一份权重时，第二个之后可能命中这里，省掉一次显存访问。' },
        { k: 'link', t: '互联端口', x: 8, y: 86, w: 180, h: 28, cls: 'nic', d: '卡到卡的直连（NVLink / Infinity Fabric / 厂商自研）或经 PCIe 到网卡。决定第 101、146 讲的 All-Reduce 代价。' },
        { k: 'cu', t: '计算单元 × 几十到几百（SM / CU）', x: 200, y: 8, w: 300, h: 20, cls: 'grp', d: '卡上的调度单位：一个线程块整体驻留在一个计算单元里，用完它的寄存器和共享内存（第 86 讲）。单元越多，一个 kernel 需要越多的块才能把卡占满。' },
        { k: 'lane', t: 'SIMT 向量通道（一个线程组 w 条）', x: 212, y: 36, w: 276, h: 30, cls: 'gpu', d: '普通的加减乘、激活函数、归约都在这里算。一个线程组里 w 条通道同一拍做同一件事；通道数 w 就是 warp 或波前的宽度。' },
        { k: 'mx', t: '矩阵核心（Tensor Core / MMAC）', x: 212, y: 72, w: 276, h: 30, cls: 'chip', d: '按固定形状吃矩阵块、吐累加结果的专用电路，例如 16×16×16。峰值算力几乎全部来自它，只有组织成矩阵乘法的计算才用得上（第 60、87 讲）。' },
        { k: 'reg', t: '寄存器堆（每单元几百 KB）', x: 212, y: 108, w: 134, h: 30, cls: 'b', d: '累加器放在这里。一个线程用多少寄存器，直接决定一个计算单元能同时驻留几个块（第 86 讲的占用率）。' },
        { k: 'smem', t: '共享内存 / LDS（几十到几百 KB）', x: 354, y: 108, w: 134, h: 30, cls: 'b', d: '块内线程共享的手动管理缓存：A、B 的分块搬进来反复用，把显存流量降到原来的 1/T（第 86、87 讲）。容量决定分块能开多大。' },
      ],
    },
    npu: {
      note: '编程模型：不是“每个线程算一个元素”，而是“描述一块数据怎么从显存搬到片上、矩阵单元算完再搬回去”。搬运由专门的单元执行，kernel 里要自己安排搬和算的流水与双缓冲；没有线程组宽度这个概念，取而代之的是缓冲容量和搬运粒度。',
      parts: [
        { k: 'hbm', t: '显存 HBM', x: 8, y: 8, w: 180, h: 34, cls: 'net', d: '和 GPGPU 一样，是 Roofline 斜线的斜率。' },
        { k: 'l2', t: 'L2 / 片上大缓冲', x: 8, y: 50, w: 180, h: 28, cls: 'sw', d: '多个核共享的一级缓冲。有的设计把它交给软件显式管理，而不是当缓存用。' },
        { k: 'link', t: '互联端口', x: 8, y: 86, w: 180, h: 28, cls: 'nic', d: '厂商自研的卡间互联，拓扑（全连接、环、立方体）直接改变集合通信的算法选择（第 146 讲）。' },
        { k: 'core', t: 'AI 核 × 几十（每核三类单元 + 多级缓冲）', x: 200, y: 8, w: 300, h: 20, cls: 'grp', d: '核的数量比 GPGPU 的计算单元少一个量级，但每个核的矩阵单元更大。于是“把卡占满”需要的并行度来源不同：靠大块，而不是靠很多小块。' },
        { k: 'scalar', t: '标量单元（取指、地址、循环控制）', x: 212, y: 36, w: 180, h: 28, cls: 'b', d: '负责控制流和地址计算，相当于把 GPGPU 里每个线程各自做的标量工作集中到一处。' },
        { k: 'mte', t: '搬运单元（MTE / DMA）', x: 400, y: 36, w: 88, h: 28, cls: 'sw', d: '显式地把数据从显存搬进片上缓冲、搬回去，并在搬运途中做格式转换（补齐、转置、分形排布）。搬和算要靠软件流水重叠起来。' },
        { k: 'vec', t: '向量单元（逐元素、归约、softmax）', x: 212, y: 72, w: 180, h: 28, cls: 'gpu', d: '对应 GPGPU 的向量通道，但它读写的是片上缓冲而不是寄存器。RMSNorm、SwiGLU、softmax 这类算子在这里算。' },
        { k: 'cube', t: '矩阵单元（Cube）', x: 400, y: 72, w: 88, h: 28, cls: 'chip', d: '一次吃一个较大的矩阵块（例如 16×16 乘 16×16，或更大），算力占全核的绝大部分。形状和对齐要求比 GPGPU 的矩阵核心更硬（第 143 讲）。' },
        { k: 'buf', t: 'L1 缓冲（几百 KB，软件管理）', x: 212, y: 108, w: 180, h: 30, cls: 'b', d: '核内最大的一级片上存储，放当前这一段 A、B 分块。容量决定一次能搬多大的块，也决定了算子怎么切。' },
        { k: 'l0', t: 'L0 A / B / C 缓冲', x: 400, y: 108, w: 88, h: 30, cls: 'b', d: '紧贴矩阵单元的三块小缓冲：两个放输入块，一个放累加结果。相当于 GPGPU 里矩阵核心的寄存器累加器，但由软件显式填充。' },
      ],
    },
  };
  function init(fig: HTMLElement) {
    let r = fig.dataset.route || 'gpgpu', pick = '';
    function draw() {
      const v = VIEWS[r];
      if (!v.parts.some((p) => p.k === pick)) pick = v.parts[0].k;
      let s = '<svg class="ai-tl-svg" viewBox="0 0 508 150">';
      for (const p of v.parts) {
        const on = p.k === pick ? ' is-pick' : '';
        s += `<g class="ai-sa-b ${p.cls}${on}" data-k="${p.k}"><rect x="${p.x}" y="${p.y}" width="${p.w}" height="${p.h}" rx="3"/>`;
        s += `<text x="${p.x + p.w / 2}" y="${p.y + p.h / 2 + 3.5}" text-anchor="middle">${p.t}</text></g>`;
      }
      s += `<path class="ai-sa-ln" d="M 188 25 L 200 25" marker-end="url(#aa-ar)"/>`;
      s += `<defs><marker id="aa-ar" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="5" markerHeight="5" orient="auto"><path class="ai-sa-ln" d="M 0 1 L 7 4 L 0 7 z"/></marker></defs>`;
      fig.querySelector<HTMLElement>('[data-svg]')!.innerHTML = s + '</svg>';
      const p = v.parts.find((x) => x.k === pick)!;
      fig.querySelector<HTMLElement>('[data-eq]')!.innerHTML = `<b>${p.t}</b>：${p.d}<br><span class="ai-faint">${v.note}</span>`;
      fig.querySelectorAll('[data-r]').forEach((b) => b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.r === r)));
    }
    fig.addEventListener('click', (e) => {
      const t = e.target as Element;
      const b = t.closest<HTMLElement>('[data-r]'); if (b) { r = b.dataset.r!; draw(); return; }
      const g = t.closest<SVGGElement>('[data-k]'); if (g) { pick = g.dataset.k!; draw(); }
    });
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-accelarch]').forEach(init);
</script>
