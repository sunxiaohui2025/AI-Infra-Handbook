---
// 首页瀑布流里的一篇：篇号 + 篇名（链接到篇页），下面列出本篇全部讲（链接到文章页）。
import { getCollection } from 'astro:content';
import { PN, partLs, pad } from '../data/course';
interface Props { p: number; ch: number }
const { p, ch } = Astro.props;
const ls = partLs(p);
const done = new Set((await getCollection('lectures')).map((e) => e.data.id));
---
<section class="ai-wf-part" data-ch={ch} data-text={`第 ${p} 篇 ${PN[p]}`.toLowerCase()}>
  <a class="ai-wf-ph" href={`/p/${p}`}>
    <span><i class="ai-dot" aria-hidden="true"></i><b>{PN[p]}{p === 6 ? '（轻量线）' : ''}</b></span>
    <span class="ai-num">→</span>
  </a>
  {ls.map((l) => (
    <a class={'ai-lk' + (l.opt ? ' is-opt' : '') + (done.has(l.id) ? ' is-done' : '')} href={`/l/${l.id}`} title={l.q} data-skip={l.fast ? undefined : '1'}
      data-text={`${pad(l.id)} ${l.title} ${l.q}`.toLowerCase()}>
      <span class="ai-num">{pad(l.id)}</span><span>{l.title}</span>
    </a>
  ))}
</section>
