---
// 一个请求流经推理引擎各模块的示意（以 vLLM 的结构为原型，SGLang 类似）。模块的方框位置写在 MODS 里，
// 每个阶段点亮几个模块，并给出这一阶段手里的数据长什么样。读者可以：上一步 / 下一步 / 拖动阶段，点模块看它负责什么。
interface Props { title?: string; caption?: string }
const { title = '一个请求流经的模块', caption } = Astro.props;
---
<figure class="ai-gt ai-rf" data-reqflow>
  <div class="ai-ms-title">{title}</div>
  <div class="ai-tl-ctl">
    <label class="ai-tl-lr"><span>阶段 <b data-sv></b></span><input type="range" min="0" max="9" step="1" value="0" data-s /></label>
    <div class="ai-gt-pre ai-pc-sets"><button data-act="prev">← 上一步</button><button data-act="next">下一步 →</button></div>
  </div>
  <div data-svg></div>
  <div class="ai-cg-eq" data-eq></div>
  {caption && <figcaption class="ai-fig-cap">{caption}</figcaption>}
</figure>

<script>
  const MODS: Record<string, [number, number, number, string, string]> = {
    client: [10, 70, 70, '客户端', '用户的程序或聊天界面，发 HTTP 请求，接收流式返回的文字。'],
    api: [100, 70, 80, 'API 服务器', '对外提供 OpenAI 兼容的接口（/v1/chat/completions），检查参数，为每个请求建一个输出流。'],
    proc: [195, 70, 90, '模板 + 分词', '把对话套上聊天模板（第 47 讲），再分词（第 21 讲），得到 token id 序列。'],
    sched: [310, 30, 95, '调度器', '每一步决定谁 decode、谁 prefill 多少个 token（第 74、77、78 讲），不超过 token 预算。'],
    kv: [310, 110, 95, 'KV 块管理', '管理块池、块表、前缀缓存（第 75、76 讲）：查命中、分配新块、结束时归还。'],
    runner: [420, 30, 80, '输入准备', '把这一步所有请求的 token 拼成一个长序列，准备位置、块表、写入位置等元数据（第 74 讲）。'],
    gpu: [420, 110, 80, 'GPU 前向', '32 层 Transformer：线性层对所有 token 一起算，注意力按块表读写 KV Cache（第 85 讲）。'],
    sampler: [515, 30, 75, '采样', '取每个请求最后一个位置的 logits，按温度、Top-p（第 73 讲）和格式约束（第 80 讲）选出下一个 token。'],
    detok: [515, 110, 75, '反分词', '把新 token 接到已生成的部分，增量地转回文字，检查结束条件（结束标记、停止词、长度上限）。'],
  };
  const STAGES: { on: string[]; t: string; d: string }[] = [
    { on: ['client', 'api'], t: '客户端发来请求', d: 'POST /v1/chat/completions　{"messages": [{"role": "user", "content": "什么是注意力？"}], "stream": true, "max_tokens": 200}' },
    { on: ['proc'], t: '套模板、分词', d: '“&lt;|begin_of_text|&gt;&lt;|start_header_id|&gt;user&lt;|end_header_id|&gt;……什么是注意力？&lt;|eot_id|&gt;……” → [128000, 128006, ……]，一串 token id' },
    { on: ['sched'], t: '进入等待队列', d: '等待队列：[……, 这个请求]。调度器每一步开始时看一眼：池子里的块够不够、这一步的 token 预算还剩多少。' },
    { on: ['sched', 'kv'], t: '被放进运行队列', d: '查前缀缓存：系统提示的整块命中，直接放进块表；没命中的部分分配新块。这一步给它排上 prefill（太长就切块）。' },
    { on: ['runner'], t: '准备这一步的输入', d: '这一步：几十个请求的 decode token + 这个请求的 prefill token，首尾相接拼成一个序列；附上每个 token 的位置、所属请求、KV 写到哪个块的哪个位置。' },
    { on: ['gpu', 'kv'], t: 'GPU 跑一步前向', d: '32 层：线性层一次算完所有 token；注意力按各自的块表读历史 KV，并把新 token 的 k、v 写进块里。输出每个请求最后一个位置的 logits（12 万多维）。' },
    { on: ['sampler'], t: '采样出第一个 token', d: 'logits → 温度、Top-p、约束掩码 → 选出一个 token id。这一刻就是 TTFT 的终点（第 70 讲）。' },
    { on: ['detok', 'api', 'client'], t: '反分词，流式返回', d: 'token id → “注意” → data: {"choices": [{"delta": {"content": "注意"}}]}　通过 SSE 推给客户端，用户看到第一个字。' },
    { on: ['sched', 'kv', 'runner', 'gpu', 'sampler', 'detok'], t: '一步一步地 decode', d: '下一步，调度器把它排进 decode（1 个 token），需要时再分配一块……每步出一个 token，每步的间隔就是 TPOT。这个循环每秒转几十到上百次。' },
    { on: ['detok', 'kv', 'api', 'client'], t: '结束', d: '生成了结束标记（或到了 max_tokens）：块的引用计数减一，提示块留在前缀缓存里；最后发 data: [DONE] 和用量统计（输入、输出 token 数）。' },
  ];
  const LINKS: [string, string][] = [['client', 'api'], ['api', 'proc'], ['proc', 'sched'], ['sched', 'kv'], ['sched', 'runner'], ['runner', 'gpu'], ['kv', 'gpu'], ['gpu', 'sampler'], ['sampler', 'detok'], ['detok', 'api']];
  function init(fig: HTMLElement) {
    const sIn = fig.querySelector<HTMLInputElement>('[data-s]')!;
    let pick = '';
    const c = (k: string) => { const [x, y, w] = MODS[k]; return [x + w / 2, y + 17]; };
    function draw() {
      const k = Number(sIn.value), st = STAGES[k];
      fig.querySelector('[data-sv]')!.textContent = `${k + 1} / ${STAGES.length}`;
      let s = '<svg class="ai-tl-svg" viewBox="0 0 600 170">';
      s += '<rect class="ai-rf-zone" x="92" y="58" width="200" height="58" rx="6"/><text class="ai-al-gl" x="96" y="160">前端进程</text>';
      s += '<rect class="ai-rf-zone" x="302" y="20" width="110" height="136" rx="6"/><text class="ai-al-gl" x="306" y="168">引擎核心</text>';
      s += '<rect class="ai-rf-zone" x="412" y="20" width="184" height="136" rx="6"/><text class="ai-al-gl" x="416" y="168">GPU 工作进程</text>';
      for (const [a, b] of LINKS) { const [x1, y1] = c(a), [x2, y2] = c(b); s += `<line class="ai-rf-link${st.on.includes(a) && st.on.includes(b) ? ' is-on' : ''}" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}"/>`; }
      for (const [id, [x, y, w, name]] of Object.entries(MODS)) s += `<g class="ai-rf-mod${st.on.includes(id) ? ' is-on' : ''}${pick === id ? ' is-pick' : ''}" data-m="${id}"><rect x="${x}" y="${y}" width="${w}" height="34" rx="5"/><text x="${x + w / 2}" y="${y + 21}" text-anchor="middle">${name}</text></g>`;
      fig.querySelector<HTMLElement>('[data-svg]')!.innerHTML = s + '</svg>';
      fig.querySelector<HTMLElement>('[data-eq]')!.innerHTML = `<b>${k + 1}. ${st.t}</b><br>${st.d}` + (pick ? `<br><span class="ai-faint">${MODS[pick][3]}：${MODS[pick][4]}</span>` : '<br><span class="ai-faint">点一个模块，看它负责什么。</span>');
    }
    sIn.addEventListener('input', draw);
    fig.addEventListener('click', (e) => {
      const t = e.target as Element, a = t.closest<HTMLElement>('[data-act]'), m = t.closest<SVGGElement>('[data-m]');
      if (a) sIn.value = String(Math.max(0, Math.min(STAGES.length - 1, Number(sIn.value) + (a.dataset.act === 'next' ? 1 : -1))));
      else if (m) pick = m.dataset.m!; else return;
      draw();
    });
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-reqflow]').forEach(init);
</script>
