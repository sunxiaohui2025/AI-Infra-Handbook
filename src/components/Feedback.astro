---
// 反馈意见表单：匿名提交（无需注册），写入后端 /api/feedback。
// 类型可选：问题 / 建议 / 表扬 / 其他。内容必填，联系方式选填。
---
<div class="ai-fb" id="ai-fb">
  <p class="ai-fb-intro">欢迎反馈。你的意见会帮助我把课程讲得更清楚。</p>

  <form id="ai-fb-form" novalidate>
    <div class="ai-fb-kind" role="radiogroup" aria-label="反馈类型">
      {[
        { v: 'bug', t: '内容有误/打不开' },
        { v: 'suggest', t: '改进建议' },
        { v: 'praise', t: '表扬' },
        { v: 'other', t: '其他' },
      ].map((k) => (
        <label class="ai-fb-kopt">
          <input type="radio" name="kind" value={k.v} checked={k.v === 'suggest'} />
          <span>{k.t}</span>
        </label>
      ))}
    </div>

    <label class="ai-fb-field">
      <span>反馈内容 <i>*</i></span>
      <textarea name="content" rows="6" required placeholder="例如：第 12 讲这张图的坐标标错了…"></textarea>
    </label>

    <label class="ai-fb-field">
      <span>联系方式（选填）</span>
      <input type="text" name="contact" placeholder="邮箱 / 微信，方便你出问题时回复；不填也能提交" />
    </label>

    <div class="ai-fb-actions">
      <button type="submit" class="ai-fb-submit">提交反馈</button>
      <span class="ai-fb-status" role="status"></span>
    </div>
  </form>

  <div class="ai-fb-done" hidden>
    <p>✅ 反馈已收到，谢谢！</p>
    <a href="/" class="ai-fb-back">返回首页</a>
    <button type="button" class="ai-fb-again">再提一条</button>
  </div>
</div>

<style>
  .ai-fb { max-width: 560px; margin: 0 auto; background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 26px 26px 24px; box-shadow: 0 8px 30px rgba(0,0,0,.04); }
  .ai-fb-intro { margin: 0 0 18px; color: #6b7280; font-size: 14px; }
  .ai-fb-kind { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .ai-fb-kopt input { position: absolute; opacity: 0; }
  .ai-fb-kopt span { display: inline-block; padding: 7px 14px; border-radius: 999px; border: 1px solid #d1d5db; color: #374151; cursor: pointer; font-size: 13px; user-select: none; transition: all .15s; }
  .ai-fb-kopt input:checked + span { background: #16193c; border-color: #16193c; color: #fff; }
  .ai-fb-field { display: block; margin-bottom: 16px; }
  .ai-fb-field > span { display: block; font-size: 13px; color: #374151; margin-bottom: 6px; }
  .ai-fb-field > span i { color: #d33; font-style: normal; }
  .ai-fb-field textarea, .ai-fb-field input[type="text"] { width: 100%; border: 1px solid #d1d5db; border-radius: 10px; padding: 10px 12px; font-size: 14px; font-family: inherit; background: #fff; color: #111827; }
  .ai-fb-field textarea:focus, .ai-fb-field input[type="text"]:focus { outline: none; border-color: #16193c; box-shadow: 0 0 0 3px rgba(22,25,60,.08); }
  .ai-fb-actions { display: flex; align-items: center; gap: 12px; }
  .ai-fb-submit { background: #16193c; color: #fff; border: none; padding: 11px 22px; border-radius: 10px; cursor: pointer; font-size: 14px; }
  .ai-fb-submit:hover { background: #262b5e; }
  .ai-fb-submit:disabled { opacity: .6; cursor: default; }
  .ai-fb-status { font-size: 13px; color: #6b7280; }
  .ai-fb-status.ok { color: #059669; }
  .ai-fb-status.err { color: #d33; }
  .ai-fb-done { text-align: center; padding: 14px 0; }
  .ai-fb-done p { font-size: 15px; margin: 0 0 14px; }
  .ai-fb-back { color: #16193c; font-weight: 600; margin-right: 16px; }
  .ai-fb-again { background: none; border: 1px solid #d1d5db; border-radius: 8px; padding: 7px 14px; cursor: pointer; }
</style>

<script>
  import { sendFeedback } from '../data/anon';

  const form = document.getElementById('ai-fb-form');
  const done = document.querySelector('.ai-fb-done');
  const status = document.querySelector('.ai-fb-status');
  const submitBtn = form?.querySelector('.ai-fb-submit');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form as HTMLFormElement);
    const content = ((fd.get('content') as string) || '').trim();
    const kind = (fd.get('kind') as string) || 'other';
    const contact = ((fd.get('contact') as string) || '').trim();
    if (!content) {
      status!.textContent = '请填写反馈内容';
      status!.className = 'ai-fb-status err';
      return;
    }
    submitBtn!.setAttribute('disabled', '');
    status!.textContent = '提交中…';
    status!.className = 'ai-fb-status';
    try {
      const r = await sendFeedback({ kind, content, contact, page: location.pathname });
      if (r && r.ok) {
        form!.hidden = true;
        done!.hidden = false;
      } else {
        status!.textContent = '提交失败，请稍后再试';
        status!.className = 'ai-fb-status err';
      }
    } catch {
      status!.textContent = '提交失败（后端未连接？），请稍后再试';
      status!.className = 'ai-fb-status err';
    } finally {
      submitBtn!.removeAttribute('disabled');
    }
  });

  document.querySelector('.ai-fb-again')?.addEventListener('click', () => {
    done!.hidden = true;
    form!.hidden = false;
    (form!.querySelector('textarea') as HTMLTextAreaElement).value = '';
    status!.textContent = '';
  });
</script>
