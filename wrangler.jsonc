{
  // AI Infra 学习网站：静态站 + 运营后台，全部部署在一个 Cloudflare Worker 上。
  // - assets.directory=./dist：静态站（astro build 产物）与 admin SPA（dist/admin/）
  // - main=./admin/worker.js：处理 /api/*（埋点/反馈/后台接口）
  // - d1_databases：数据存 D1（SQLite），绑定名 DB
  // 部署：sh admin/deploy/deploy-cloudflare.sh
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-infra-handbook",
  "compatibility_date": "2026-11-10",
  "main": "./admin/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-infra-handbook-db",
      "database_id": "2c8f5959-0f28-4fe8-a711-b3d797abdc70"
    }
  ]
}
