---
// 调度和计算重叠（SGLang 的 event_loop_overlap、vLLM 的异步调度，见第 129、131 讲）。
//   串行：每一步 = CPU 调度并准备输入 C + GPU 计算 G + CPU 处理结果 P，GPU 在 C、P 期间空着。
//   重叠：发射第 i 步之后不等它算完，立刻处理第 i−1 步的结果、调度第 i+1 步；稳态下一步 = max(G, C + P)。
//   代价：调度第 i+1 步时还不知道第 i 步采样出的 token，只能先放占位（vLLM 的 output placeholders），所以多跑一步、晚一步发现请求已经结束。
// 读者可以：调 CPU、GPU 的时间，对比两种方式的时间线和每秒步数。
interface Props { title?: string; caption?: string }
const { title = '让 CPU 的调度藏在 GPU 计算的后面', caption } = Astro.props;
---
<figure class="ai-gt ai-ol" data-overlap>
  <div class="ai-ms-title">{title}</div>
  <div class="ai-tl-ctl">
    <label class="ai-tl-k">GPU 一步 <input type="range" min="2" max="40" value="12" data-g /> <b data-gv></b> ms</label>
    <label class="ai-tl-k">CPU 调度 + 准备输入 <input type="range" min="0" max="20" value="3" data-c /> <b data-cv></b> ms</label>
    <label class="ai-tl-k">CPU 处理结果 <input type="range" min="0" max="20" value="2" data-p /> <b data-pv></b> ms</label>
  </div>
  <div data-svg></div>
  <div class="ai-cg-eq" data-eq></div>
  {caption && <figcaption class="ai-fig-cap">{caption}</figcaption>}
</figure>

<script>
  function init(fig: HTMLElement) {
    const q = (s: string) => fig.querySelector<HTMLInputElement>(s)!;
    const gI = q('[data-g]'), cI = q('[data-c]'), pI = q('[data-p]');
    function draw() {
      const G = +gI.value, C = +cI.value, P = +pI.value;
      fig.querySelector('[data-gv]')!.textContent = String(G); fig.querySelector('[data-cv]')!.textContent = String(C); fig.querySelector('[data-pv]')!.textContent = String(P);
      const T = 100, W = 820, x0 = 70, sc = W / T;
      const bar = (y: number, a: number, b: number, cls: string, t: string) => b <= a || a >= T ? '' : `<rect x="${x0 + a * sc}" y="${y}" width="${(Math.min(b, T) - a) * sc}" height="16" class="${cls}"/>` + ((Math.min(b, T) - a) * sc > 18 ? `<text class="ai-al-gl" x="${x0 + (a + Math.min(b, T)) / 2 * sc}" y="${y + 12}" text-anchor="middle">${t}</text>` : '');
      let s = `<svg class="ai-tl-svg" viewBox="0 0 900 190">`;
      s += `<text class="ai-al-gl" x="0" y="14">串行</text><text class="ai-al-gl" x="0" y="34">CPU</text><text class="ai-al-gl" x="0" y="54">GPU</text>`;
      let t = 0, n1 = 0;
      for (let i = 1; t < T; i++) { s += bar(22, t, t + C, 'ai-ol-c', `调${i}`); s += bar(42, t + C, t + C + G, 'ai-ol-g', `算${i}`); s += bar(22, t + C + G, t + C + G + P, 'ai-ol-p', `收${i}`); t += C + G + P; if (t <= T) n1++; }
      s += `<text class="ai-al-gl" x="0" y="104">重叠</text><text class="ai-al-gl" x="0" y="124">CPU</text><text class="ai-al-gl" x="0" y="144">GPU</text>`;
      // 重叠：第 i 步的发射时间 L_i；GPU 在 max(L_i, 上一步算完) 开始；CPU 发射 i 之后处理 i−1 的结果、再调度 i+1
      let cpu = C, gpuFree = 0, n2 = 0; const launch: number[] = [];
      s += bar(112, 0, C, 'ai-ol-c', '调1');
      for (let i = 1; i < 200; i++) {
        launch[i] = cpu; const gs = Math.max(cpu, gpuFree), ge = gs + G; s += bar(132, gs, ge, 'ai-ol-g', `算${i}`);
        if (i > 1) { const ps = Math.max(cpu, gpuFree); s += bar(112, ps, ps + P, 'ai-ol-p', `收${i - 1}`); cpu = ps + P; }  // 等上一步算完才能处理它的结果
        gpuFree = ge; if (ge <= T) n2++;
        s += bar(112, cpu, cpu + C, 'ai-ol-c', `调${i + 1}`); cpu += C;
        if (gs > T) break;
      }
      s += `<line x1="${x0}" y1="160" x2="${x0 + W}" y2="160" class="ai-st-grid"/><text class="ai-al-gl" x="${x0}" y="176">0</text><text class="ai-al-gl" x="${x0 + W}" y="176" text-anchor="end">${T} ms</text></svg>`;
      fig.querySelector<HTMLElement>('[data-svg]')!.innerHTML = s;
      const serial = C + G + P, over = Math.max(G, C + P);
      fig.querySelector<HTMLElement>('[data-eq]')!.innerHTML = `串行：一步 ${serial} ms，GPU 忙的比例 ${(G / serial * 100).toFixed(0)}%。重叠：稳态一步 max(${G}, ${C} + ${P}) = ${over} ms，GPU 忙的比例 ${(G / over * 100).toFixed(0)}%，吞吐是串行的 ${(serial / over).toFixed(2)} 倍。`
        + (C + P > G ? ' CPU 比 GPU 还慢时，重叠也藏不住，瓶颈变成了 CPU：这就是为什么调度器本身也要写得快。' : '');
    }
    [gI, cI, pI].forEach((x) => x.addEventListener('input', draw));
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-overlap]').forEach(init);
</script>
