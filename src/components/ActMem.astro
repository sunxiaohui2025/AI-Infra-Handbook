---
// 训练时激活的显存（第 104 讲）。每层激活按 Korthikanti 等人 2022 年的估算（16 位激活、GPT 结构、含 dropout）：
//   不重算：s·b·h·(34 + 5·a·s/h) 字节；其中 5·a·s²·b 是注意力分数、softmax、dropout 存下的 [a, s, s] 矩阵。
//   FlashAttention / 选择性重算：不存这些 [a, s, s]，剩 34·s·b·h（反向时重算注意力，多花约 4s / (3(24h + 4s)) 的计算）。
//   全部重算：每层只存输入 2·s·b·h；反向到某一层时再把这一层的激活算出来（峰值再加一层的 34·s·b·h，重算时用 FlashAttention），计算多一次前向，约 +33%。
//   张量并行 t 路 + 序列并行时，激活都除以 t。Llama 的 FFN 是 SwiGLU、没有 dropout，系数略有不同，这里只看量级和趋势。
// 读者可以：选模型，调序列长度、micro-batch、张量并行度，切换重算策略，看每卡激活多大、要多算多少。
interface Props { title?: string; caption?: string }
const { title = '激活占多少显存：序列越长越吓人', caption } = Astro.props;
---
<figure class="ai-gt ai-act" data-actmem>
  <div class="ai-ms-title">{title}</div>
  <div class="ai-tl-ctl">
    <span class="ai-gt-pre ai-pc-sets" data-group="m"><button data-m="0" aria-pressed="true">Llama-3-8B</button><button data-m="1">Llama-3-70B</button></span>
    <span class="ai-gt-pre ai-pc-sets" data-group="st"><button data-st="0">不重算</button><button data-st="1" aria-pressed="true">FlashAttention / 选择性重算</button><button data-st="2">全部重算</button></span>
  </div>
  <div class="ai-tl-ctl">
    <label class="ai-tl-k">序列长度 s <input type="range" min="0" max="7" value="3" data-s /> <b data-sv></b></label>
    <label class="ai-tl-k">micro-batch b <input type="range" min="1" max="8" value="1" data-b /> <b data-bv></b></label>
    <label class="ai-tl-k">张量并行 t <input type="range" min="0" max="3" value="0" data-t /> <b data-tv></b></label>
  </div>
  <div data-svg></div>
  <div class="ai-cg-eq" data-eq></div>
  {caption && <figcaption class="ai-fig-cap">{caption}</figcaption>}
</figure>

<script>
  const MODELS = [{ n: 'Llama-3-8B', h: 4096, a: 32, L: 32, P: 8.03e9 }, { n: 'Llama-3-70B', h: 8192, a: 64, L: 80, P: 70.6e9 }];
  const S = [1024, 2048, 4096, 8192, 16384, 32768, 65536, 131072], TP = [1, 2, 4, 8];
  function act(h: number, a: number, L: number, s: number, b: number, t: number, st: number) {
    const lin = 34 * s * b * h, att = 5 * a * s * s * b;
    const per = st === 0 ? lin + att : lin;
    const bytes = st === 2 ? (L * 2 * s * b * h + lin) / t : (L * per) / t;
    const extra = st === 0 ? 0 : st === 1 ? 4 * s / (3 * (24 * h + 4 * s)) : 1 / 3;
    return { bytes, extra, lin, att };
  }
  function init(fig: HTMLElement) {
    const q = (s: string) => fig.querySelector<HTMLInputElement>(s)!;
    const sI = q('[data-s]'), bI = q('[data-b]'), tI = q('[data-t]');
    let m = 0, st = 1;
    function draw() {
      const M = MODELS[m], s = S[+sI.value], b = +bI.value, t = TP[+tI.value];
      fig.querySelector('[data-sv]')!.textContent = s >= 1024 ? `${s / 1024}K` : String(s);
      fig.querySelector('[data-bv]')!.textContent = String(b); fig.querySelector('[data-tv]')!.textContent = String(t);
      const r = [0, 1, 2].map((k) => act(M.h, M.a, M.L, s, b, t, k)), cur = r[st];
      const state = 16 * M.P / 8 / t;                 // ZeRO-3 切到 8 路数据并行、再除以张量并行度
      const GB = (x: number) => x / 1e9, maxv = Math.max(80, GB(r[0].bytes) + GB(state)) * 1.05;
      const W = 880, x0 = 150, sc = (W - x0) / maxv;
      const names = ['不重算', 'Flash / 选择性', '全部重算'];
      let svg = `<svg class="ai-tl-svg" viewBox="0 0 900 128">`;
      r.forEach((x, k) => {
        const y = 8 + k * 34;
        svg += `<text class="ai-al-gl" x="0" y="${y + 17}">${names[k]}</text><rect x="${x0}" y="${y}" width="${GB(state) * sc}" height="24" class="ai-act-st"/><rect x="${x0 + GB(state) * sc}" y="${y}" width="${Math.max(1, GB(x.bytes) * sc)}" height="24" class="${k === st ? 'ai-act-on' : 'ai-act-off'}"/>`;
        svg += `<text class="ai-al-gl" x="${Math.min(W - 4, x0 + (GB(state) + GB(x.bytes)) * sc + 6)}" y="${y + 17}"${x0 + (GB(state) + GB(x.bytes)) * sc > W - 120 ? ' text-anchor="end"' : ''}>${GB(x.bytes).toFixed(1)} GB</text>`;
      });
      svg += `<line x1="${x0 + 80 * sc}" y1="4" x2="${x0 + 80 * sc}" y2="110" class="ai-act-cap"/><text class="ai-al-gl" x="${x0 + 80 * sc - 4}" y="122" text-anchor="end">80 GB 一张卡</text></svg>`;
      fig.querySelector<HTMLElement>('[data-svg]')!.innerHTML = svg;
      fig.querySelector<HTMLElement>('[data-eq]')!.innerHTML = `${M.n}，s = ${s}，b = ${b}，张量并行 ${t} 路：每卡激活 <b>${GB(cur.bytes).toFixed(1)} GB</b>，计算多 <b>${(cur.extra * 100).toFixed(1)}%</b>。灰色是参数、梯度、优化器状态（16 字节/参数，ZeRO-3 切到 8 路数据并行后每卡 ${GB(state).toFixed(1)} GB）。`
        + `<br>每层里，和 s 成正比的部分 34·s·b·h = ${GB(cur.lin / t).toFixed(2)} GB，注意力分数那一项 5·a·s²·b = ${GB(cur.att / t).toFixed(2)} GB${s >= 8192 ? '：s 大了以后它是大头，而且随 s² 涨' : ''}。`;
      fig.querySelectorAll('[data-m]').forEach((x) => x.setAttribute('aria-pressed', String(+(x as HTMLElement).dataset.m! === m)));
      fig.querySelectorAll('[data-st]').forEach((x) => x.setAttribute('aria-pressed', String(+(x as HTMLElement).dataset.st! === st)));
    }
    fig.addEventListener('click', (e) => {
      const t = e.target as Element;
      const a = t.closest<HTMLElement>('[data-m]'); if (a) { m = +a.dataset.m!; draw(); return; }
      const b = t.closest<HTMLElement>('[data-st]'); if (b) { st = +b.dataset.st!; draw(); }
    });
    [sI, bI, tI].forEach((x) => x.addEventListener('input', draw));
    draw();
  }
  document.querySelectorAll<HTMLElement>('[data-actmem]').forEach(init);
</script>
